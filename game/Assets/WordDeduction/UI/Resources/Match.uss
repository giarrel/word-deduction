.match-screen { flex-grow: 1; padding: 12px 22px 16px; max-width: 600px; width: 100%; align-self: center; }
.match-toolbar { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; margin-bottom: 10px; }
.match-small { min-height: 52px; padding: 0 10px; color: #5734a6; }
.match-kicker { color: var(--muted); font-size: 13px; -unity-font-style: bold; }
.match-body { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.match-title { font-size: 30px; -unity-font-style: bold; white-space: normal; letter-spacing: -0.7px; margin-bottom: 10px; flex-shrink: 0; }
.match-text { font-size: 17px; white-space: normal; color: var(--muted); margin-bottom: 16px; flex-shrink: 0; }
.match-note { font-size: 14px; white-space: normal; color: var(--muted); margin: 8px 0; flex-shrink: 0; }
.match-actions { flex-shrink: 0; margin-top: 12px; }
.match-actions > Button { margin-top: 8px; min-height: 54px; white-space: normal; }
.match-secondary { background-color: var(--lilac); color: #503093; min-height: 54px; white-space: normal; }
.match-danger { color: #9e3436; }
.match-center { flex-grow: 1; justify-content: center; }
.card-progress { color: var(--muted); font-size: 14px; -unity-text-align: middle-center; margin-bottom: 5px; }
.card-owner { font-size: 30px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center; margin-bottom: 6px; }
.card-slot { flex-grow: 1; flex-shrink: 1; min-height: 230px; max-height: 390px; justify-content: flex-end; padding: 40px 12px 10px; margin-top: 8px; }
.secret-card { height: 220px; flex-shrink: 1; min-height: 180px; border-radius: 32px; background-color: #ece5ff; border-width: 2px; border-color: #d8c9f8; justify-content: center; align-items: center; padding: 20px; }
.card-symbol { font-size: 66px; -unity-font-style: bold; color: #6a48c8; }
.card-caption { color: #503093; font-size: 16px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center; }
.secret-word { font-size: 32px; color: #38215e; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center; }
.secret-card.revealed { background-color: #e0ecdf; border-color: #b5cdb3; }
.card-instruction { font-size: 14px; white-space: normal; color: var(--muted); -unity-text-align: middle-center; margin: 8px 0; }
.hold-reveal { min-height: 54px; border-radius: 18px; border-width: 2px; border-color: #c7b8e8; color: #503093; justify-content: center; margin-top: 8px; padding: 8px 12px; flex-shrink: 0; }
.hold-reveal > Label { white-space: normal; -unity-text-align: middle-center; font-size: 16px; -unity-font-style: bold; }
.hold-reveal:focus { border-color: #6a48c8; }
.starting-person { border-radius: 24px; background-color: #e0ecdf; padding: 18px; margin: 12px 0 20px; }
.starting-person .match-title { margin-bottom: 0; }
.vote-list { flex-grow: 1; flex-shrink: 1; min-height: 60px; }
.vote-list .unity-scroller--vertical { width: 6px; min-width: 6px; margin-left: 4px; }
.vote-list .unity-scroller__low-button, .vote-list .unity-scroller__high-button { display: none; }
.vote-list .unity-base-slider { min-width: 6px; margin: 0; padding: 0; }
.vote-list .unity-base-slider__tracker { background-color: #eee9df; border-width: 0; }
.vote-list .unity-base-slider__dragger { background-color: #b3a4c3; border-width: 0; border-radius: 3px; }
.suspect-choice { background-color: white; border-radius: 18px; min-height: 58px; margin-bottom: 8px; -unity-text-align: middle-left; padding: 10px 16px; font-size: 18px; white-space: normal; }
.suspect-choice.selected { background-color: var(--lilac); border-width: 2px; border-color: var(--purple); }
.result-banner { background-color: #e0ecdf; border-radius: 24px; padding: 18px; margin-bottom: 14px; }
.result-banner .match-title { font-size: 28px; }
.result-word { background-color: white; border-radius: 20px; padding: 12px 16px; margin-bottom: 8px; }
.result-word .match-note { margin: 0 0 4px; }
.result-word .match-title { font-size: 24px; margin: 0; }
.role-row { flex-direction: row; justify-content: space-between; padding: 10px 4px; border-bottom-width: 1px; border-bottom-color: #e5ded2; }
.role-name { font-size: 16px; white-space: normal; flex-grow: 1; flex-shrink: 1; margin-right: 12px; }
.role-label { color: #5734a6; font-size: 14px; -unity-font-style: bold; }
.match-screen .hidden { display: none; }
.compact .card-slot { min-height: 190px; padding-top: 28px; }
.compact .secret-card { height: 180px; min-height: 155px; }
.compact .card-owner { font-size: 26px; }
.compact .match-title { font-size: 26px; }
