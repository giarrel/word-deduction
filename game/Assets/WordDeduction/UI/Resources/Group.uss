:root { --ink: #242134; --muted: #635e71; --paper: #faf7f0; --purple: #6a48c8; --lilac: #ece5ff; }
.safe-root { flex-grow: 1; background-color: var(--paper); color: var(--ink); font-size: 16px; }
.screen { flex-grow: 1; padding: 20px 22px 16px; max-width: 600px; width: 100%; align-self: center; }
.topbar { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-shrink: 0; }
.wordmark { font-size: 16px; -unity-font-style: bold; letter-spacing: -0.3px; }
.language-switch { flex-direction: row; background-color: #eee9df; border-radius: 20px; padding: 3px; }
Button { border-width: 0; border-radius: 16px; color: var(--ink); margin: 0; padding: 0 12px; min-height: 48px; background-color: transparent; -unity-font-style: bold; font-size: 15px; }
Button:focus { border-width: 2px; border-color: var(--purple); }
Button:active { background-color: #d9d0ef; }
Button:disabled { opacity: 0.65; }
.language-button { border-radius: 16px; min-width: 44px; padding: 0 8px; }
.language-button.selected { background-color: white; }
.heading { margin-bottom: 20px; flex-shrink: 0; }
.title { font-size: 34px; -unity-font-style: bold; letter-spacing: -1px; white-space: normal; }
.subtitle { color: var(--muted); font-size: 15px; white-space: normal; margin-top: 4px; }
.group-header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px; flex-shrink: 0; }
.section-title { -unity-font-style: bold; font-size: 18px; }
.count-badge { background-color: #e0ecdf; color: #31472f; border-radius: 12px; padding: 6px 10px; font-size: 13px; -unity-font-style: bold; }
.players { flex-grow: 1; flex-shrink: 1; min-height: 60px; }
.player-row { flex-direction: row; align-items: center; background-color: white; border-radius: 18px; min-height: 60px; margin-bottom: 8px; padding: 4px 6px; flex-shrink: 0; }
.player-row.paused { background-color: #eeeae2; }
.player-initial { width: 38px; height: 38px; border-radius: 14px; background-color: var(--lilac); color: #503093; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 17px; flex-shrink: 0; }
.player-name { flex-grow: 1; flex-shrink: 1; -unity-text-align: middle-left; white-space: normal; font-size: 16px; min-width: 0; padding: 6px 10px; }
.participation { min-width: 62px; color: var(--muted); font-size: 13px; padding: 0 7px; flex-shrink: 0; }
.paused .participation { background-color: white; color: #503093; }
.editing-row { flex-direction: column; align-items: stretch; padding: 8px; }
.edit-actions { flex-direction: row; justify-content: space-between; margin-top: 4px; }
.remove-button { color: #9e3436; }
.save-button { background-color: var(--lilac); color: #503093; }
.name-input { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0; min-height: 52px; font-size: 17px; }
.name-input > .unity-text-field__input { background-color: white; border-color: #d5cede; border-width: 1px; border-radius: 16px; padding: 12px 14px; color: var(--ink); }
.name-input > .unity-text-field__input:focus { border-width: 2px; border-color: var(--purple); }
.add-row { flex-direction: row; margin-top: 8px; flex-shrink: 0; }
.add-button { width: 52px; min-height: 52px; margin-left: 8px; border-radius: 18px; background-color: var(--purple); color: white; font-size: 28px; }
.hint { white-space: normal; color: var(--muted); font-size: 13px; }
.edit-hint { margin-top: 7px; margin-bottom: 16px; flex-shrink: 0; }
.empty-state { flex-grow: 1; justify-content: center; align-items: center; min-height: 125px; }
.empty-symbol { background-color: var(--lilac); border-radius: 24px; width: 72px; height: 78px; font-size: 42px; -unity-font-style: bold; -unity-text-align: middle-center; color: var(--purple); rotate: -7deg; margin-bottom: 14px; }
.empty-title { font-size: 19px; -unity-font-style: bold; margin-bottom: 5px; }
.mode-picker { flex-direction: row; background-color: #eae5df; border-radius: 20px; padding: 4px; flex-shrink: 0; }
.mode-button { flex-grow: 1; flex-basis: 0; border-radius: 16px; min-height: 48px; }
.mode-button.selected { background-color: white; color: #5734a6; }
.mode-description { font-size: 13px; color: var(--muted); white-space: normal; min-height: 38px; margin: 8px 4px 10px; -unity-text-align: upper-center; flex-shrink: 0; }
.play-button { min-height: 58px; border-radius: 20px; background-color: var(--purple); color: white; font-size: 19px; flex-shrink: 0; }
.start-hint { font-size: 12px; color: var(--muted); -unity-text-align: middle-center; white-space: normal; margin-top: 9px; flex-shrink: 0; }
.notice-panel { background-color: #f7e3d4; border-radius: 16px; padding: 8px 12px; margin-bottom: 12px; flex-shrink: 0; }
.notice-text { color: #6d382c; font-size: 14px; white-space: normal; }
.text-button { min-height: 48px; color: #5734a6; align-self: flex-start; padding: 0; }
.hidden { display: none; }
.compact .heading { display: none; }
.compact .topbar { margin-bottom: 12px; }
.compact .edit-hint { margin-bottom: 10px; }
.typing .heading, .typing .mode-picker, .typing .mode-description, .typing .play-button, .typing .start-hint, .typing .empty-state, .typing .edit-hint { display: none; }
.typing .topbar { margin-bottom: 10px; }
.players .unity-scroller--vertical { width: 6px; min-width: 6px; margin-left: 4px; }
.players .unity-scroller__low-button, .players .unity-scroller__high-button { display: none; }
.players .unity-base-slider { margin: 0; padding: 0; }
.players .unity-base-slider__tracker { background-color: #eee9df; border-width: 0; }
.players .unity-base-slider__dragger { background-color: #b3a4c3; border-width: 0; border-radius: 3px; }
.has-players .heading { display: none; }
.editing .add-row, .editing .edit-hint { display: none; }
